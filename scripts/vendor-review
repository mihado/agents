#!/usr/bin/env node
// Advisory scan over content newly introduced by `scripts/vendor --fetch`.
//
// Vendored skills are prose (SKILL.md, references/*.md) that an agent reads
// and follows as instructions, plus executable scripts (.sh/.py/.js/.mjs)
// that agents or hooks may run. Both are an upstream-controlled supply
// chain. `scripts/vendor` already proves *integrity* (hash-locked, path-
// safe, license-tracked); this script is a second pass for *content risk*
// that hashing cannot catch: prompt injection embedded in instructions, and
// shell/exec/exfiltration patterns embedded in scripts.
//
// Regex only sees literal patterns — it cannot follow a value from an env
// var through three variables into a network call. For deeper analysis
// (AST + taint tracking + YARA), this script calls NVIDIA's SkillSpector
// (https://github.com/NVIDIA/skillspector) statically only (`--no-llm`, no
// skill content leaves the machine) — using an installed copy if present
// on PATH, otherwise an ephemeral `uvx` run with no persistent install.
// Neither is a dependency of this repo; both are best-effort extras.
//
// Non-blocking by design: findings are for a human to eyeball, not a gate.
// Run after `scripts/vendor --fetch`, before committing.
//
// Usage:
//   scripts/vendor-review                 scan diff, filter against baseline
//   scripts/vendor-review --show-suppressed  also list baseline-suppressed hits
//   scripts/vendor-review --accept-baseline  accept all current findings as reviewed

import crypto from "node:crypto";
import fs from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const baselinePath = path.join(root, ".vendor-review-baseline.json");
const args = new Set(process.argv.slice(2));
const showSuppressed = args.has("--show-suppressed");
const acceptBaseline = args.has("--accept-baseline");

const INJECTION_PATTERNS = [
  [/ignore (all |any )?(previous|prior|above) instructions/i, "instruction override"],
  [/disregard (the |your |all )?(system prompt|previous|prior)/i, "instruction override"],
  [/you are (now|no longer) (bound|restricted|limited)/i, "role/constraint override"],
  [/do not (tell|inform|mention|warn) the user/i, "conceal from user"],
  [/without (the user|user's|the human)('s)? (knowledge|consent|awareness)/i, "conceal from user"],
  [/(send|post|upload|exfiltrat\w*)\s+(the\s+)?(contents?|file|data|key|token|secret|credential)s?\s+(to|via)\s+https?:\/\//i, "possible exfiltration instruction"],
  [/read\s+(the\s+)?(~\/\.ssh|\.env|id_rsa|credentials|\.aws\/credentials|\.netrc)/i, "credential/secret access instruction"],
  [/curl\s+[^\n]*\|\s*(sh|bash|zsh)/i, "remote-script execution"],
  [/base64\s+-d/i, "encoded payload decode"],
  [/\u200b|\u200c|\u200d|\ufeff/, "zero-width/invisible character"],
];

const CODE_RISK_PATTERNS = [
  [/curl\s+[^\n]*\|\s*(sh|bash|zsh)/i, "remote-script execution"],
  [/\beval\s*\(/, "eval()"],
  [/require\(['"]child_process['"]\)|from\s+child_process|import.*child_process/, "child_process"],
  [/\b(child_process\.)?exec(Sync|File)?\s*\(\s*['"`]/, "shell exec() with string command"],
  [/subprocess\.(run|Popen|call|check_output)/, "subprocess"],
  [/os\.system\s*\(/, "os.system()"],
  [/rm\s+-rf\s+\//, "rm -rf /"],
  [/base64\s+-d/, "base64 decode"],
  [/process\.env\[/, "dynamic env var access"],
  [/os\.environ\[/, "dynamic env var access"],
];

const PROSE_EXTS = new Set([".md", ".mdx", ".txt"]);
const CODE_EXTS = new Set([".sh", ".py", ".js", ".mjs", ".cjs", ".ts"]);

const diffOutput = run("git", [
  "-C",
  root,
  "diff",
  "--no-color",
  "--unified=0",
  "HEAD",
  "--",
  ".agents/skills",
]);

if (!diffOutput.trim()) {
  console.log(
    "No staged/unstaged changes under .agents/skills. Run after `scripts/vendor --fetch` and before committing.",
  );
  process.exit(0);
}

const findings = [];
let currentFile = null;
let currentExt = null;

for (const line of diffOutput.split("\n")) {
  const fileMatch = line.match(/^\+\+\+ b\/(.+)$/);
  if (fileMatch) {
    currentFile = fileMatch[1];
    currentExt = path.extname(currentFile).toLowerCase();
    continue;
  }
  if (!currentFile) continue;
  if (!line.startsWith("+") || line.startsWith("+++")) continue;

  const added = line.slice(1);
  const patterns = PROSE_EXTS.has(currentExt)
    ? INJECTION_PATTERNS
    : CODE_EXTS.has(currentExt)
      ? [...INJECTION_PATTERNS, ...CODE_RISK_PATTERNS]
      : [];

  for (const [pattern, label] of patterns) {
    if (pattern.test(added)) {
      const snippet = added.trim().slice(0, 160);
      findings.push({ file: currentFile, label, snippet, fingerprint: fingerprint(currentFile, label, snippet) });
    }
  }
}

const baseline = readBaseline();

if (acceptBaseline) {
  writeBaseline(mergeBaseline(baseline, findings));
  console.log(`Accepted ${findings.length} finding(s) into ${path.relative(root, baselinePath)}.`);
  process.exit(0);
}

const knownFingerprints = new Set(baseline.map((entry) => entry.fingerprint));
const newFindings = findings.filter((f) => !knownFingerprints.has(f.fingerprint));
const suppressed = findings.filter((f) => knownFingerprints.has(f.fingerprint));

if (newFindings.length === 0) {
  console.log(
    suppressed.length > 0
      ? `No new findings (${suppressed.length} already accepted in baseline).`
      : "No suspicious patterns found in newly added skill content.",
  );
} else {
  console.log(`${newFindings.length} new finding(s) to review (advisory, not blocking):\n`);
  for (const { file, label, snippet } of newFindings) {
    console.log(`${file}\n  [${label}] ${snippet}\n`);
  }
  console.log(
    "Review each hit above. These are pattern matches, not proof of a problem — " +
      "vendored SKILL.md content is instructions an agent will follow, so read it as such.\n" +
      "If reviewed and accepted, run `scripts/vendor-review --accept-baseline` to silence it on future scans.",
  );
}

if (showSuppressed && suppressed.length > 0) {
  console.log(`\n${suppressed.length} suppressed finding(s) (in baseline):\n`);
  for (const { file, label, snippet } of suppressed) {
    console.log(`${file}\n  [${label}] ${snippet}\n`);
  }
}

runSkillspectorIfAvailable(diffOutput);

function fingerprint(file, label, snippet) {
  return crypto.createHash("sha256").update(`${file}\0${label}\0${snippet}`).digest("hex").slice(0, 16);
}

function readBaseline() {
  if (!fs.existsSync(baselinePath)) return [];
  try {
    const parsed = JSON.parse(fs.readFileSync(baselinePath, "utf8"));
    return Array.isArray(parsed.accepted) ? parsed.accepted : [];
  } catch (error) {
    console.error(`error: cannot read ${baselinePath}: ${error.message}`);
    process.exit(1);
  }
}

function mergeBaseline(existing, newFindings) {
  const byFingerprint = new Map(existing.map((entry) => [entry.fingerprint, entry]));
  for (const { file, label, snippet, fingerprint: fp } of newFindings) {
    if (!byFingerprint.has(fp)) {
      byFingerprint.set(fp, { fingerprint: fp, file, label, snippet, acceptedAt: new Date().toISOString().slice(0, 10) });
    }
  }
  return [...byFingerprint.values()].sort((a, b) => a.fingerprint.localeCompare(b.fingerprint));
}

function writeBaseline(entries) {
  fs.writeFileSync(baselinePath, `${JSON.stringify({ accepted: entries }, null, 2)}\n`);
}

function runSkillspectorIfAvailable(currentDiffOutput) {
  const invocation = resolveSkillspectorInvocation();
  if (!invocation) {
    console.log(
      "\n(optional) skillspector not available (not on PATH, and `uvx` not found for an ephemeral run). " +
        "Regex-only scan above. For AST/taint/YARA-level analysis: https://github.com/NVIDIA/skillspector",
    );
    return;
  }

  const changedSkillDirs = new Set();
  for (const line of currentDiffOutput.split("\n")) {
    const fileMatch = line.match(/^\+\+\+ b\/(\.agents\/skills\/[^/]+\/[^/]+)\//);
    if (fileMatch) changedSkillDirs.add(fileMatch[1]);
  }

  if (changedSkillDirs.size === 0) return;

  console.log(
    `\nRunning skillspector (${invocation.label}, static-only --no-llm) on ${changedSkillDirs.size} changed skill(s):\n`,
  );
  for (const relDir of [...changedSkillDirs].sort()) {
    const result = spawnSync(
      invocation.command,
      [...invocation.args, "scan", relDir, "--no-llm", "--format", "json"],
      { cwd: root, encoding: "utf8", maxBuffer: 1024 * 1024 * 64 },
    );
    if (result.status === 2 || result.error) {
      console.log(`${relDir}: skillspector error (${result.stderr?.trim() || result.error?.message || "unknown"})`);
      continue;
    }
    try {
      const report = JSON.parse(result.stdout);
      const { score, severity, recommendation } = report.risk_assessment ?? {};
      console.log(`${relDir}: score=${score} severity=${severity} recommendation=${recommendation}`);
    } catch {
      console.log(`${relDir}: could not parse skillspector output`);
    }
  }
}

function resolveSkillspectorInvocation() {
  // Prefer the repo-local venv managed by uv (pyproject.toml pins the commit).
  const localBin = path.join(root, ".venv", "bin", "skillspector");
  if (fs.existsSync(localBin)) {
    return { command: localBin, args: [], label: "venv (uv sync)" };
  }
  // Fallback: globally installed.
  if (spawnSync("which", ["skillspector"], { encoding: "utf8" }).status === 0) {
    return { command: "skillspector", args: [], label: "installed" };
  }
  return null;
}

function run(command, commandArgs) {
  const result = spawnSync(command, commandArgs, { encoding: "utf8", maxBuffer: 1024 * 1024 * 64 });
  if (result.status !== 0 && result.status !== null) {
    console.error(`error: ${command} ${commandArgs.join(" ")} failed:\n${result.stderr}`);
    process.exit(1);
  }
  return result.stdout;
}
