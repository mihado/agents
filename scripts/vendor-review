#!/usr/bin/env node
// Advisory scan of vendored skill changes introduced by `scripts/vendor --fetch`.
//
// Scans the git diff under .agents/skills/ for injection and exec-risk
// patterns. Filters findings against the baseline (previously accepted
// findings) so only genuinely new hits surface. Optionally runs skillspector
// on changed skill directories.
//
// Non-blocking by design: findings are for a human to eyeball, not a gate.
// Run after `scripts/vendor --fetch`, before committing.
//
// Usage:
//   scripts/vendor-review                 scan diff, show new findings only
//   scripts/vendor-review --accept        accept all current findings into baseline
//   scripts/vendor-review --show-suppressed  also list baseline-suppressed hits
//   scripts/vendor-review --skillspector  also run skillspector on changed skills

import path from "node:path";
import { spawnSync } from "node:child_process";
import { fileURLToPath } from "node:url";
import { scanLines, fingerprint } from "./lib/scanner.js";
import { readBaseline, writeBaseline, mergeBaseline } from "./lib/baseline.js";
import { runSkillspector } from "./lib/skillspector.js";
import { PROSE_EXTS, CODE_EXTS } from "./lib/patterns.js";

const root = path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const baselinePath = path.join(root, ".vendor-review-baseline.json");
const args = new Set(process.argv.slice(2));
const acceptMode = args.has("--accept");
const showSuppressed = args.has("--show-suppressed");
const withSkillspector = args.has("--skillspector");

// --- Get diff ---

const diffOutput = run("git", [
  "-C", root, "diff", "--no-color", "--unified=0", "HEAD", "--", ".agents/skills",
]);

if (!diffOutput.trim()) {
  console.log(
    "No staged/unstaged changes under .agents/skills. Run after `scripts/vendor --fetch` and before committing.",
  );
  process.exit(0);
}

// --- Scan added lines ---

const findings = [];
let currentFile = null;
let currentExt = null;

for (const line of diffOutput.split("\n")) {
  const fileMatch = line.match(/^\+\+\+ b\/(.+)$/);
  if (fileMatch) {
    currentFile = fileMatch[1];
    currentExt = path.extname(currentFile).toLowerCase();
    continue;
  }
  if (!currentFile) continue;
  if (!line.startsWith("+") || line.startsWith("+++")) continue;

  const added = line.slice(1);
  const lineFindings = scanLines([added], currentExt);
  for (const f of lineFindings) {
    findings.push({
      file: currentFile,
      label: f.label,
      snippet: f.snippet,
      fingerprint: fingerprint(currentFile, f.label, f.snippet),
    });
  }
}

// --- Baseline filtering ---

const baseline = readBaseline(baselinePath);

if (acceptMode) {
  writeBaseline(baselinePath, mergeBaseline(baseline, findings));
  console.log(`Accepted ${findings.length} finding(s) into ${path.relative(root, baselinePath)}.`);
  process.exit(0);
}

const knownFingerprints = new Set(baseline.map((entry) => entry.fingerprint));
const newFindings = findings.filter((f) => !knownFingerprints.has(f.fingerprint));
const suppressed = findings.filter((f) => knownFingerprints.has(f.fingerprint));

if (newFindings.length === 0) {
  console.log(
    suppressed.length > 0
      ? `No new findings (${suppressed.length} already accepted in baseline).`
      : "No suspicious patterns found in newly added skill content.",
  );
} else {
  console.log(`${newFindings.length} new finding(s) to review (advisory, not blocking):\n`);
  for (const { file, label, snippet } of newFindings) {
    console.log(`${file}\n  [${label}] ${snippet}\n`);
  }
  console.log(
    "Review each hit above. These are pattern matches, not proof of a problem — " +
      "vendored SKILL.md content is instructions an agent will follow, so read it as such.\n" +
      "If reviewed and accepted, run `scripts/vendor-review --accept` to silence on future scans.",
  );
}

if (showSuppressed && suppressed.length > 0) {
  console.log(`\n${suppressed.length} suppressed finding(s) (in baseline):\n`);
  for (const { file, label, snippet } of suppressed) {
    console.log(`${file}\n  [${label}] ${snippet}\n`);
  }
}

// --- Skillspector on changed skills ---

if (withSkillspector) {
  const changedSkillDirs = new Set();
  for (const line of diffOutput.split("\n")) {
    const match = line.match(/^\+\+\+ b\/(\.agents\/skills\/[^/]+\/[^/]+)\//);
    if (match) changedSkillDirs.add(match[1]);
  }
  if (changedSkillDirs.size > 0) {
    const result = runSkillspector(root, [...changedSkillDirs]);
    if (!result) {
      console.log("\nskillspector not available. Run `make setup` to install.");
    } else {
      console.log(
        `\nSkillspector (${result.label}, static-only --no-llm) on ${result.results.length} changed skill(s):\n`,
      );
      for (const r of result.results) {
        if (r.error) {
          console.log(`  ${path.basename(r.dir).padEnd(35)} error: ${r.error}`);
        } else {
          console.log(
            `  ${path.basename(r.dir).padEnd(35)} score=${String(r.score).padEnd(3)} severity=${String(r.severity).padEnd(8)} issues=${r.issueCount}`,
          );
        }
      }
    }
  }
}

// --- Helpers ---

function run(command, commandArgs) {
  const result = spawnSync(command, commandArgs, { encoding: "utf8", maxBuffer: 1024 * 1024 * 64 });
  if (result.status !== 0 && result.status !== null) {
    console.error(`error: ${command} ${commandArgs.join(" ")} failed:\n${result.stderr}`);
    process.exit(1);
  }
  return result.stdout;
}
