{
  "plugin": [],
  "permission": {
    "external_directory": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow"
    },
    "read": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow",
      "*.env.test*": "allow",
      "*.env.example*": "allow"
    },
    "edit": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask"
    }
  },
  "provider": {
    "c9": {
      "name": "c9.rter.cc",
      "baseURL": "https://c9.rter.cc/v1",
      "apiKey": "{env:C9RTER_API_KEY}",
      "models": {
        "cx/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 200000, "output": 58400 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "cx/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 200000, "output": 58400 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "cx/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 200000, "output": 58400 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },

        "glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 1000000, "output": 131072 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "glm-5.2-fusion": {
          "name": "GLM-5.2 Fusion",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 1000000, "output": 131072 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "commandcode": {
      "name": "CommandCode",
      "baseURL": "https://api.commandcode.ai/provider/v1",
      "apiKey": "{env:COMMANDCODE_API_KEY}",
      "headers": {
        "x-cmd-zdr": "1"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "DeepSeek V4.1 Flash",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 1000000, "output": 384000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "z-ai/glm-5.3-flash": {
          "name": "GLM-5.3 Flash",
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          "limit": { "context": 1000000, "output": 131072 },
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  }
}
