{
  "plugins": ["opencode-anthropic-login-via-cli@1.7.0"],
  "websearch": {
    "provider": "parallel"
  },
  "permission": {
    "external_directory": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow"
    },
    "read": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow",
      "*.env.test*": "allow",
      "*.env.example*": "allow"
    },
    "edit": {
      "~/.claude/**": "allow",
      "~/.agents/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/Repos/**": "allow",
      "~/Work/**": "allow"
    },
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf *": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git reset --hard*": "ask",
      "git clean -f*": "ask"
    }
  },
  "provider": {}
}
