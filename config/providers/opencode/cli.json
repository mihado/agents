{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "hide"
  },
  "animations": true,
  "plugins": [
    "./herdr-opencode"
  ],
  "tabs": {
    "enabled": false
  },
  "keybinds": {
    "session.background": "ctrl+z"
  }
}
